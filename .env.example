# DagsHub Configuration for MLflow Integration
# Copy this to .env and fill in your credentials

# Your DagsHub repository URL
# Format: https://dagshub.com/username/repository-name
DAGSHUB_REPO_URL=https://dagshub.com/youssef.maged237/sentiment-classifier

# Your DagsHub authentication token
# Get it from: https://dagshub.com/user/settings/tokens
DAGSHUB_TOKEN=

# Optional: MLflow settings
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Optional: Experiment tracking
MLFLOW_EXPERIMENT_NAME=sentiment-classification
MLFLOW_RUN_NAME=
